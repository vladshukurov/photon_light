#version 300 es
precision highp float;

/*
  Временное накопление.

  Марш дымки — это оценка интеграла по случайным точкам: джиттер сдвигает
  выборку внутри шага, и ошибка выходит шумом, а не полосами. Но джиттер у нас
  считался от координаты пикселя, то есть в каждом кадре был ОДИН И ТОТ ЖЕ, и
  усреднять было нечего: сколько кадров ни рисуй, ошибка стоит на месте.

  Стоит сдвигать джиттер по кадрам — и среднее по кадрам становится точнее
  одного кадра. Полного 1/sqrt(N) здесь не выходит: джиттер один на весь луч,
  а не свой на каждый шаг (так в базовом шейдере, и менять нельзя — на
  побайтном совпадении с ним держится нейтральность вкладки), поэтому кадры
  не независимы. По замеру выходит около полутора раз: 24 шага дают отклонение
  0.27 деления за кадр и 0.19 за пять.

  Накопление идёт по ЛИНЕЙНОМУ HDR, до bloom: иначе усреднялись бы уже сжатые
  тональной кривой значения, и среднее вышло бы смещённым.

  Ничего не перепроецируется: камера неподвижна, двигается только содержимое
  среды, и двигается медленно. Поэтому хватает скользящего среднего с
  ограниченной глубиной — при uAlpha 0.2 хвост живёт пять кадров, то есть
  восьмую долю секунды, а кадр за это время меняется на сотые доли деления.
*/

in vec2 vUv;
out vec4 fragColor;

uniform sampler2D uCurrent;
uniform sampler2D uHistory;
uniform float uAlpha;   // 1 — история отбрасывается, меньше — копим

void main() {
  vec3 cur = texture(uCurrent, vUv).rgb;
  vec3 his = texture(uHistory, vUv).rgb;
  float a = clamp(uAlpha, 0.0, 1.0);
  fragColor = vec4(mix(his, cur, a), 1.0);
}
